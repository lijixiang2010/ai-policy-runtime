{
  "name": "ai-policy-runtime",
  "displayName": "AI Policy Runtime",
  "description": "Generate better AI code with task-aware policies for Codex and Claude Code.",
  "version": "0.1.0",
  "publisher": "cppmore",
  "author": {
    "name": "Miles Li"
  },
  "license": "Apache-2.0",
  "preview": true,
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "miles-li",
    "codex",
    "claude-code",
    "policy",
    "ai",
    "agent",
    "rules",
    "cpp",
    "code-quality",
    "review",
    "refactoring"
  ],
  "homepage": "https://github.com/lkimuk/ai-policy-runtime#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/lkimuk/ai-policy-runtime.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/lkimuk/ai-policy-runtime/issues"
  },
  "activationEvents": [
    "onCommand:aiPolicy.enable",
    "onCommand:aiPolicy.disable",
    "onCommand:aiPolicy.enablePostRefine",
    "onCommand:aiPolicy.configurePacks",
    "onCommand:aiPolicy.showStatus",
    "onCommand:aiPolicy.showEffectiveRules",
    "onCommand:aiPolicy.validateRuntime",
    "onView:aiPolicy.config",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiPolicy",
          "title": "AI Policy Runtime",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "aiPolicy": [
        {
          "id": "aiPolicy.config",
          "name": "Configuration",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "aiPolicy.enable",
        "title": "AI Policy Runtime: Enable"
      },
      {
        "command": "aiPolicy.disable",
        "title": "AI Policy Runtime: Disable"
      },
      {
        "command": "aiPolicy.enablePostRefine",
        "title": "AI Policy Runtime: Enable Post-Task Refinement"
      },
      {
        "command": "aiPolicy.configurePacks",
        "title": "AI Policy Runtime: Configure Packs"
      },
      {
        "command": "aiPolicy.showStatus",
        "title": "AI Policy Runtime: Show Status"
      },
      {
        "command": "aiPolicy.showEffectiveRules",
        "title": "AI Policy Runtime: Show Effective Rules"
      },
      {
        "command": "aiPolicy.validateRuntime",
        "title": "AI Policy Runtime: Validate Runtime"
      }
    ],
    "configuration": {
      "title": "AI Policy Runtime",
      "properties": {
        "aiPolicy.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable AI Policy Runtime for this workspace."
        },
        "aiPolicy.agents": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "codex",
              "claude"
            ]
          },
          "default": [
            "codex"
          ],
          "description": "AI coding agents that should use this workspace policy configuration."
        },
        "aiPolicy.packs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "cpp.safe_generation"
          ],
          "description": "Policy packs to activate for agent prompts."
        },
        "aiPolicy.policyRoot": {
          "type": "string",
          "default": "",
          "description": "Optional policy asset root. Leave empty to let the Claude/Codex hook resolve its own plugin root."
        },
        "aiPolicy.autoInstall": {
          "type": "boolean",
          "default": true,
          "description": "Install missing AI Policy Runtime Python dependencies automatically when agent hooks run."
        },
        "aiPolicy.embeddingProvider": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "openai-compatible",
            "openai",
            "local",
            "disabled"
          ],
          "enumDescriptions": [
            "Automatically choose the best configured semantic provider.",
            "Use an OpenAI-compatible /v1/embeddings endpoint.",
            "Alias for OpenAI-compatible /v1/embeddings.",
            "Use a local sentence-transformers model.",
            "Disable semantic embedding matching."
          ],
          "description": "Semantic embedding provider for task analysis."
        },
        "aiPolicy.embeddingBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional OpenAI-compatible embeddings base URL, such as https://api.openai.com/v1."
        },
        "aiPolicy.embeddingApiKey": {
          "type": "string",
          "default": "",
          "description": "Optional API key for the OpenAI-compatible embeddings endpoint. Leave empty to use OPENAI_API_KEY."
        },
        "aiPolicy.embeddingModel": {
          "type": "string",
          "default": "",
          "description": "Optional embedding model. Defaults to text-embedding-3-small for OpenAI-compatible endpoints."
        },
        "aiPolicy.embeddingTimeout": {
          "type": "string",
          "default": "",
          "description": "Optional embedding request timeout in seconds."
        },
        "aiPolicy.postRefine": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "light",
            "standard",
            "strict"
          ],
          "enumDescriptions": [
            "Do not ask supported agents to continue with a refinement pass.",
            "Ask for a light review-oriented refinement continuation.",
            "Ask a supported agent to continue once with a production refinement pass.",
            "Ask a supported agent to continue once with a stricter release-quality refinement pass."
          ],
          "description": "Agent Stop-hook post-task refinement mode."
        },
        "aiPolicy.postRefinePacks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "cpp.production_refinement"
          ],
          "description": "Policy packs added for the agent post-task refinement continuation."
        },
        "aiPolicy.verifyTarget": {
          "type": "string",
          "default": "",
          "description": "Optional file or directory agents should verify during strict post-task refinement."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "vsce package",
    "publish": "vsce publish",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "2.32.0",
    "typescript": "5.4.5"
  }
}
