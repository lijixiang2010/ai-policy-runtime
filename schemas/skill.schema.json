{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-policy-runtime.local/schemas/skill.schema.json",
  "title": "AI Policy Runtime Skill",
  "type": "object",
  "required": ["skill", "rules"],
  "properties": {
    "skill": {
      "type": "object",
      "required": ["id", "name", "version", "level", "domain", "priority", "activation"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["experimental", "stable", "deprecated"]},
        "level": {"type": "string", "enum": ["platform", "domain", "project", "task", "user"]},
        "domain": {"type": "string", "minLength": 1},
        "category": {"type": "string"},
        "priority": {"type": "integer"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "activation": {"type": "object"}
      },
      "additionalProperties": true
    },
    "task_analysis": {"type": "object"},
    "rules": {
      "type": "object",
      "properties": {
        "hard": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
        "soft": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
        "preference": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
        "preferences": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
      },
      "additionalProperties": true
    },
    "exceptions": {"type": "array"},
    "verification": {"type": ["array", "object"]}
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "target"],
      "anyOf": [
        {"required": ["must"]},
        {"required": ["must_not"]},
        {"required": ["should"]},
        {"required": ["should_not"]},
        {"required": ["allow"]},
        {"required": ["prefer"]}
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "when": {"type": "string"},
        "unless": {"type": "string"},
        "must": {},
        "must_not": {},
        "should": {},
        "should_not": {},
        "allow": {},
        "prefer": {},
        "over": {},
        "require": {"type": "array", "items": {"type": "string"}},
        "verification": {"type": "array"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
