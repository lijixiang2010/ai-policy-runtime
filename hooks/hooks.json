{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/ai-policy-hook.js",
              "claude-user-prompt-submit"
            ],
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/ai-policy-hook.js",
              "claude-stop-refinement"
            ],
            "timeout": 120
          }
        ]
      }
    ]
  }
}
